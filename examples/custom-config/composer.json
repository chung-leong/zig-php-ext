{
    "name": "mycompany/custom-config",
    "description": "A description of my application",    
    "version": "0.1.0",
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "classmap": [
            "test/"
        ]
    },
    "scripts": {
        "test": "php ./vendor/bin/phpunit --testdox test/*Test.php --display-warnings"
    },
    "require": {
        "revolt/event-loop": "^1.0",
        "php-school/cli-menu": "^4.3",
        "nelexa/zip": "^4.0"
    },
    "zig": {
        "config": {
            "cfg_string": { 
                "title": "Test String",
                "description": "Configuration option that is a string",
                "prompt": "Enter a string",
                "default": "Hello world"
            },
            "cfg_int": { 
                "title": "Test integer",
                "type": "usize",
                "description": "Configuration option that is an integer",
                "prompt": "Enter an integer",
                "default": 1234
            },
            "cfg_float": { 
                "title": "Test float",
                "type": "f64",
                "description": "Configuration option that is a float",
                "prompt": "Enter an float",
                "default": 0.1234
            },
            "cfg_bool": { 
                "title": "Test boolean",
                "description": "Configuration option that is a boolean",
                "default": false
            },
            "cfg_flag": { 
                "title": "Test flag set",
                "description": "Configuration option flag",
                "prompt": "Set one or more",
                "type" : "Flag",
                "choices": { 
                    "alpha": "Alpha",
                    "beta": "Beta",
                    "gamma": "Gamma"
                },
                "default": [ "alpha", "beta" ]
            },
            "some_enum": { 
                "title": "Test enum",
                "description": "Configuration option that is an enum",
                "prompt": "Select one",
                "type" : "Enum",
                "choices": {
                    "apple": "You like apple",
                    "banana": "You like banana", 
                    "cantaloupe": "You hate cantaloupe" 
                },
                "default": "cantaloupe"
            }
        }
    }
}
