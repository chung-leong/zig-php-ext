{
    "name": "mycompany/hello",
    "description": "A description of my application",    
    "version": "0.1.0",
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "classmap": [
            "test/"
        ]
    },
    "scripts": {
        "test": "php ./vendor/bin/phpunit --testdox test/*Test.php --display-warnings"
    },
    "require": {
        "revolt/event-loop": "^1.0",
        "php-school/cli-menu": "^4.3",
        "nelexa/zip": "^4.0"
    },
    "zig": {
        "config": {
            "something": { 
                "title": "Test string",
                "prompt": "Enter something",
                "default": "Hello world"
            },
            "something_int": { 
                "title": "Test integer",
                "prompt": "Enter some integer",
                "default": 1234
            },
            "something_bool": { 
                "title": "Test boolean",
                "prompt": "Enter some integer",
                "default": false
            },
            "some_flag": { 
                "title": "Test flag set",
                "prompt": "Set one or more",
                "choices": { 
                    "alpha": "Alpha",
                    "beta": "Beta",
                    "gamma": "Gamma"
                },
                "default": [ "alpha" ]
            },
            "some_enum": { 
                "title": "Test enum",
                "prompt": "Select one",
                "choices": {
                    "apple": "You like apple",
                    "banana": "You like banana", 
                    "cantaloupe": "You hate cantaloupe" 
                },
                "default": "cantaloupe"
            }
        }
    }
}
